{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn"],
    "no-console": "off",
    "no-undef": "error",
    "consistent-return": "warn",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"]
  }
}